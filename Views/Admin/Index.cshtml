@using Task9.Models
@model List<AppUser>
@{
    ViewData["Title"] = "Admin Panel";
}

<h2>Admin Panel</h2>
<p>Welcome, admin.</p>

<table class="table" style="max-width:600px">
    <thead>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>Role</th>
            <th>Registered</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Email</td>
                <td>@u.Role</td>
                <td>@u.CreatedAt.ToString("dd.MM.yyyy")</td>
            </tr>
        }
    </tbody>
</table>
